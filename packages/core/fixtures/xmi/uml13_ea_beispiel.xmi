<?xml version="1.0" encoding="windows-1252"?>
<XMI xmi.version="1.1" xmlns:UML="omg.org/UML1.3" timestamp="2026-11-16 09:00:00">
  <XMI.header>
    <XMI.documentation>
      <XMI.exporter>Enterprise Architect (Sparx Systems)</XMI.exporter>
      <XMI.exporterVersion>16.1</XMI.exporterVersion>
    </XMI.documentation>
    <XMI.metamodel xmi.name="UML" xmi.version="1.3"/>
  </XMI.header>
  <XMI.content>
    <UML:Model xmi.id="EAPK_ROOT" name="Beispielmodell">
      <UML:Namespace.ownedElement>
        <UML:Package xmi.id="EAPK_A" name="Facharchitektur" isAbstract="false">
          <UML:Namespace.ownedElement>
            <UML:Class xmi.id="EAID_C1" name="Kunde" isAbstract="false">
              <UML:ModelElement.taggedValue>
                <UML:TaggedValue tag="Autor" value="Muster"/>
              </UML:ModelElement.taggedValue>
            </UML:Class>
            <UML:Class xmi.id="EAID_C2" name="Vertrag" isAbstract="false"/>
            <UML:Association xmi.id="EAID_AS1" name="hat">
              <UML:Association.connection>
                <UML:AssociationEnd type="EAID_C1" name="kunde"/>
                <UML:AssociationEnd type="EAID_C2" name="vertrag"/>
              </UML:Association.connection>
            </UML:Association>
            <UML:Generalization xmi.id="EAID_G1" child="EAID_C2" parent="EAID_C1"/>
            <UML:Diagram xmi.id="EAID_D1" name="Sicht Facharchitektur" diagramType="Logical">
              <UML:Diagram.element>
                <UML:DiagramElement geometry="Left=20;Top=-30;Right=120;Bottom=-80;" subject="EAID_C1"/>
                <UML:DiagramElement geometry="Left=180;Top=-30;Right=300;Bottom=-90;" subject="EAID_C2"/>
              </UML:Diagram.element>
            </UML:Diagram>
          </UML:Namespace.ownedElement>
        </UML:Package>
      </UML:Namespace.ownedElement>
    </UML:Model>
  </XMI.content>
</XMI>
