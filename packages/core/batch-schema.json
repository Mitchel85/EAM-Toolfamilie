{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelBatch",
  "description": "JSON-Batch aus einem Architekturmodell: Knoten (Pakete, Elemente) und Kanten (Beziehungen). Verbindlicher Vertrag fuer json_batch.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "nodes", "edges"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "standard", "source_document", "node_count", "edge_count"],
      "properties": {
        "generator": { "type": "string", "minLength": 1 },
        "standard": { "type": "string" },
        "source_document": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "node_count": { "type": "integer", "minimum": 0 },
        "edge_count": { "type": "integer", "minimum": 0 },
        "chunk": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "metaclass", "labels"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "stereotype": { "type": "string" },
          "metaclass": { "type": "string", "minLength": 1 },
          "package": { "type": "string" },
          "labels": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "properties": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_id", "target_id", "connector", "metaclass"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "minLength": 1 },
          "target_id": { "type": "string", "minLength": 1 },
          "connector": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "metaclass": { "type": "string", "minLength": 1 },
          "properties": { "type": "object" }
        }
      }
    }
  }
}
