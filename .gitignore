__pycache__/
*.pyc
.pytest_cache/
dist/
*.qea.edit-tmp
/scratch/

# Altwerkzeug-Build schreibt GitHub-Pages-Spiegel; nicht Teil der Auslieferung.
apps/*/docs/

# Grosse Fixtures liegen im internen Fixture-Store; die Musterarchitektur ist die Ausnahme (versionierte Test-Fixture).
# Grosse Pruefmodelle bleiben lokal -- Ausnahme: die versionierte oeffentliche Test-Fixture
# (Pruefsumme in packages/core/ci/fixtures_manifest.json)
packages/core/fixtures/*.qea
!packages/core/fixtures/Musterarchitektur_MASC.qea

# Vendor-Kopien der Apps entstehen beim Bauen aus vendor/ (scripts/sync_vendor.py).
apps/*/vendor/

# Lokale Agent-Arbeitsstaende
.hermes/

# Testergebnis des Script-Makers: enthaelt absolute Pfade, wird beim Lauf erzeugt
apps/admbw-script-maker/tests/results.json
